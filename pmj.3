.brand-logo-text {
  width: 54px;
  height: 54px;
  background-color: #ffffff;
  color: #be185d;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 800;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}